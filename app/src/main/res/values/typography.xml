<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================ -->
    <!-- TYPOGRAPHY SYSTEM - Teacher Scheduler -->
    <!-- ============================================ -->

    <!-- Base Text Appearance -->
    <style name="TextAppearance.App" parent="TextAppearance.Material3.BodyMedium" />

    <!-- HEADINGS (SemiBold) -->
    <style name="TextAppearance.App.Headline1">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.App.Headline2">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- SECTION TITLES (SemiBold) -->
    <style name="TextAppearance.App.SectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- BODY TEXT (Regular) -->
    <style name="TextAppearance.App.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.App.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_light</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- CAPTIONS (Regular) -->
    <style name="TextAppearance.App.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_light</item>
    </style>

    <!-- NUMBERS & STATS (Medium) -->
    <style name="TextAppearance.App.StatNumber">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.App.StatLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_light</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- BUTTON TEXT (Medium) -->
    <style name="TextAppearance.App.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- TAB TEXT -->
    <style name="TextAppearance.App.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.App.Tab.Selected">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
