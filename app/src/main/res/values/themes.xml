<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================== -->
    <!-- APPLE-STYLE PREMIUM THEME -->
    <!-- ========================================== -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/accent_beige</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSecondaryContainer">#FFFFFF</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">#F5F5F7</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/text_secondary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">#F5F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F5F5F7</item>

        <!-- Transitions -->
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowEnterTransition">@transition/slide_fade_enter</item>
        <item name="android:windowExitTransition">@transition/slide_fade_exit</item>
        <item name="android:windowSharedElementEnterTransition">@transition/shared_element</item>
        <item name="android:windowSharedElementExitTransition">@transition/shared_element</item>

        <!-- Material Components -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

        <!-- Text Appearances -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    
    <!-- Legacy theme name for backward compatibility -->
    <style name="Theme.TeacherScheduler" parent="AppTheme" />
    
    <style name="Theme.TeacherScheduler.NoActionBar" parent="AppTheme" />

    <!-- ========================================== -->
    <!-- COMPONENT STYLES -->
    <!-- ========================================== -->

    <!-- Card Style -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <style name="Widget.App.CardView.Elevated" parent="Widget.App.CardView">
        <item name="cardElevation">4dp</item>
    </style>

    <!-- FAB Style -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="elevation">4dp</item>
        <item name="backgroundTint">@color/accent_pink</item>
        <item name="tint">#FFFFFF</item>
        <item name="android:stateListAnimator">@animator/fab_state_list_anim</item>
    </style>
    
    <!-- Bottom Navigation Style -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">0dp</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
    </style>
</resources>