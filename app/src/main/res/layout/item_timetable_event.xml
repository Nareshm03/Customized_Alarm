<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Event Type Indicator -->
        <View
            android:id="@+id/eventTypeIndicator"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@color/colorPrimary"/>

        <!-- Event Time -->
        <TextView
            android:id="@+id/eventTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="09:00 - 10:30"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Event Title -->
        <TextView
            android:id="@+id/eventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mathematics"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="2"
            android:layout_marginTop="2dp"/>

        <!-- Event Subtitle/Location -->
        <TextView
            android:id="@+id/eventSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room 101"
            android:textSize="11sp"
            android:textColor="@color/colorTextSecondary"
            android:alpha="0.9"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="1dp"/>

        <!-- Event Department/Category (for classes) -->
        <TextView
            android:id="@+id/eventDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Science Dept"
            android:textSize="10sp"
            android:textColor="@color/colorTextSecondary"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            android:layout_marginTop="1dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
